{
	"if": {
		"prefix": "if",
		"body": ["{% if ${1:condition} %}", "\t$0", "{% endif %}"],
		"description": "if block"
	},
	"if else": {
		"prefix": "ifelse",
		"body": ["{% if ${1:condition} %}", "\t$2", "{% else %}", "\t$0", "{% endif %}"],
		"description": "if / else block"
	},
	"elif": {
		"prefix": "elif",
		"body": ["{% elif ${1:condition} %}", "$0"],
		"description": "elif branch"
	},
	"else": {
		"prefix": "else",
		"body": ["{% else %}", "$0"],
		"description": "else branch"
	},
	"for": {
		"prefix": "for",
		"body": ["{% for ${1:item} in ${2:items} %}", "\t$0", "{% endfor %}"],
		"description": "for loop"
	},
	"for else": {
		"prefix": "forelse",
		"body": ["{% for ${1:item} in ${2:items} %}", "\t$3", "{% else %}", "\t$0", "{% endfor %}"],
		"description": "for loop with else branch for empty collections"
	},
	"asyncEach": {
		"prefix": "asyncEach",
		"body": ["{% asyncEach ${1:item} in ${2:items} %}", "\t$0", "{% endeach %}"],
		"description": "asyncEach loop (async, sequential)"
	},
	"asyncAll": {
		"prefix": "asyncAll",
		"body": ["{% asyncAll ${1:item} in ${2:items} %}", "\t$0", "{% endall %}"],
		"description": "asyncAll loop (async, parallel)"
	},
	"macro": {
		"prefix": "macro",
		"body": ["{% macro ${1:name}(${2:args}) %}", "\t$0", "{% endmacro %}"],
		"description": "macro definition"
	},
	"call": {
		"prefix": "call",
		"body": ["{% call ${1:macro}(${2:args}) %}", "\t$0", "{% endcall %}"],
		"description": "call block, available inside the macro as caller()"
	},
	"filter": {
		"prefix": "filter",
		"body": ["{% filter ${1:name} %}", "\t$0", "{% endfilter %}"],
		"description": "filter block"
	},
	"set": {
		"prefix": "set",
		"body": ["{% set ${1:name} = ${2:value} %}"],
		"description": "set a variable"
	},
	"set block": {
		"prefix": "setblock",
		"body": ["{% set ${1:name} %}", "\t$0", "{% endset %}"],
		"description": "set a variable to the rendered block content"
	},
	"extends": {
		"prefix": "extends",
		"body": ["{% extends \"${1:layout}\" %}"],
		"description": "extends a parent template"
	},
	"block": {
		"prefix": "block",
		"body": ["{% block ${1:name} %}", "\t$0", "{% endblock %}"],
		"description": "block for template inheritance"
	},
	"include": {
		"prefix": "include",
		"body": ["{% include \"${1:template}\" %}"],
		"description": "include a template"
	},
	"include ignore missing": {
		"prefix": "includeignore",
		"body": ["{% include \"${1:template}\" ignore missing %}"],
		"description": "include a template, silently skip it if missing"
	},
	"import": {
		"prefix": "import",
		"body": ["{% import \"${1:template}\" as ${2:name} %}"],
		"description": "import a template's macros under a name"
	},
	"from import": {
		"prefix": "from",
		"body": ["{% from \"${1:template}\" import ${2:macro} %}"],
		"description": "import specific macros from a template"
	},
	"raw": {
		"prefix": "raw",
		"body": ["{% raw %}", "\t$0", "{% endraw %}"],
		"description": "raw block, contents are not parsed as Nunjucks"
	},
	"verbatim": {
		"prefix": "verbatim",
		"body": ["{% verbatim %}", "\t$0", "{% endverbatim %}"],
		"description": "verbatim block, alias of raw"
	},
	"comment": {
		"prefix": "comment",
		"body": ["{# ${1:comment} #}"],
		"description": "comment"
	},
	"comment block": {
		"prefix": "commentblock",
		"body": ["{#", "\t$0", "#}"],
		"description": "multi-line comment"
	},
	"variable": {
		"prefix": "var",
		"body": ["{{ ${1:variable} }}"],
		"description": "output an expression"
	},
	"super": {
		"prefix": "super",
		"body": ["{{ super() }}"],
		"description": "render the parent block's content"
	},
	"caller": {
		"prefix": "caller",
		"body": ["{{ caller() }}"],
		"description": "render the call block inside a macro"
	},
	"loop": {
		"prefix": "loop",
		"body": ["loop.${1|index,index0,revindex,revindex0,first,last,length|}"],
		"description": "loop variable inside a for block"
	}
}
